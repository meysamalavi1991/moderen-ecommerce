# Environment
APP_ENV=development
APP_DEBUG=true
APP_URL=http://shop.local

# Domains
SHOP_DOMAIN=shop.local
CMS_DOMAIN=cms.shop.local

# MariaDB
DB_DATABASE=modern_ecommerce
DB_USERNAME=modern_ecommerce_user
DB_PASSWORD=change_me_db_password
DB_ROOT_PASSWORD=change_me_root_password

# WordPress
WORDPRESS_DB_HOST=mariadb:3306
WORDPRESS_DB_NAME=${DB_DATABASE}
WORDPRESS_DB_USER=${DB_USERNAME}
WORDPRESS_DB_PASSWORD=${DB_PASSWORD}

# WordPress Security
WORDPRESS_AUTH_KEY=change_me
WORDPRESS_SECURE_AUTH_KEY=change_me
WORDPRESS_LOGGED_IN_KEY=change_me
WORDPRESS_NONCE_KEY=change_me
WORDPRESS_AUTH_SALT=change_me
WORDPRESS_SECURE_AUTH_SALT=change_me
WORDPRESS_LOGGED_IN_SALT=change_me
WORDPRESS_NONCE_SALT=change_me

# Frontend
NEXT_PUBLIC_SITE_URL=http://shop.local
WORDPRESS_API_URL=http://wordpress

# phpMyAdmin
PMA_PORT=8081
